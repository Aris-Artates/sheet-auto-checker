{
  "name": "leyeco3-qa-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Runs the rule-based checks from the QA Role Access Testing sheet with Playwright and logs results to its Check Log.",
  "type": "module",
  "scripts": {
    "qa": "node src/run.js",
    "qa:dry": "node src/run.js --dry",
    "setup": "npx playwright install chromium",
    "qa:dp": "node src/run-dp.js",
    "ui": "node src/ui/server.js",
    "make-test-files": "node src/make-big-files.js",
    "make-edit-rows": "node src/make-edit-rows.js"
  },
  "dependencies": {
    "dotenv": "16.4.5",
    "playwright": "1.48.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
