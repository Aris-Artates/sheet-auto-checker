# QA Runner settings. Copy to .env (or use the Settings tab in the UI).
# .env is git-ignored. NEVER commit real values; share them privately.

# --- Sheet connection
# Link to the QA Google Sheet (only used for the "Open QA sheet" button).
SHEET_URL=
# Apps Script web app URL (Deploy > Manage deployments > Web app URL, ends in /exec).
SHEET_WEBAPP_URL=
# Same value as the QA_TOKEN Script Property in the sheet's Apps Script.
SHEET_TOKEN=
# Name written in the Check Log. Add the same name to the sheet's Team tab.
CHECKER_NAME=QA Bot

# --- App addresses (base URL, no trailing slash)
APP_URL_VERCEL=
APP_URL_DOTNET=

# --- Test accounts: username:password (leave empty if you have no account for that role)
ACCOUNT_NEWQRPHOADMIN=
ACCOUNT_PAYROLL_OFFICER=
ACCOUNT_PAYROLL_STAFF=
ACCOUNT_PAYROLL_APPROVING_OFFICER=
ACCOUNT_PAYROLL_MGMT=
ACCOUNT_LEAVE_IMMEDIATE_HEAD=
ACCOUNT_LEAVE_CAMPUS_ADMIN=
ACCOUNT_EMPLOYEE=
# Accounts that must be REFUSED at login (e.g. a subscriber-only account, one with no role).
ACCOUNT_INVALID_ROLES=
ACCOUNT_NO_ROLES=

# --- Test data (data tests create and delete records)
# Employee ID of the test employee. Every test record is applied to this employee only.
QA_EMPLOYEE_EID=
# Optional: a second test employee, for the edit tests that switch a record to another employee.
QA_EMPLOYEE_EID_2=
# Folder with the sample reference files (default: test-files in this folder).
QA_FILES_DIR=test-files
# true = allow risky page groups (rates, gov tables, payments, users, settings...) that can affect everyone.
ALLOW_RISKY_PAGES=false
# true = unlock writing test data on the .NET deployment. Every run still asks you to type DOTNET.
ALLOW_DATA_ON_DOTNET=false

# --- Timing / misc
SETTLE_MS=3000
PAGE_TIMEOUT_MS=30000
# "off" disables the Windows pop-up when a run ends.
QA_NOTIFY=on
# Port for the local UI (default 4317).
QA_UI_PORT=4317
